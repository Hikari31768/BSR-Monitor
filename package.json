{
  "name": "bsr-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run tauri dev",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/kill-dev.ps1",
    "dev:force": "powershell -ExecutionPolicy Bypass -File scripts/kill-dev.ps1 -Force",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File scripts/kill-dev.ps1 -Force && npm run tauri dev",
    "build": "tsc && vite build",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "cd .e2e && npx playwright test",
    "test:e2e:headed": "cd .e2e && npx playwright test --headed",
    "test:e2e:visual": "cd .e2e && VISUAL_TEST=1 npx playwright test",
    "test:e2e:ui": "cd .e2e && npx playwright test --ui"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "lucide-react": "^1.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
